# TrafficVision AI — production settings (Milestone 4)
#
# Copy to the VM as ~/trafficvision/.env and fill in real values there.
# NEVER commit the filled-in file. Generate secrets with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
#
# Env var contract (SRS 7.1): owner Intern 1. Keep in sync with the M4 deployment plan.

# --- Database (Intern 2) -------------------------------------------------------
# Self-hosted Postgres on the VM by default. For a managed DB, replace the host part of
# DATABASE_URL and POSTGRES_HOST with the provider's host.
POSTGRES_DB=trafficvision
POSTGRES_USER=traffic
POSTGRES_PASSWORD=
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
DATABASE_URL=postgresql+psycopg2://traffic:<POSTGRES_PASSWORD>@postgres:5432/trafficvision

# --- Cache ---------------------------------------------------------------------
REDIS_URL=redis://redis:6379/0

# --- Auth (Intern 1) -----------------------------------------------------------
# The backend refuses to start without JWT_SECRET_KEY (app/security/config.py).
JWT_SECRET_KEY=
SECRET_KEY=
ALGORITHM=HS256
# Shared key the congestion watcher / alert producers use for the internal alert endpoint.
ALERT_SERVICE_KEY=

# --- External APIs -------------------------------------------------------------
MAPS_API_KEY=

# --- Gateway (Intern 1, M4 Day 3) ---------------------------------------------
# Comma-separated frontend origin(s), e.g. https://trafficvision.netlify.app
CORS_ALLOWED_ORIGINS=
