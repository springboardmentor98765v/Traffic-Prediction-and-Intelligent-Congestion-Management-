{
  "root": true,
  "env": {
    "browser": true,
    "node": true,
    "es2022": true
  },
  "extends": ["eslint:recommended", "plugin:import/recommended", "prettier"],
  "parserOptions": {
    "ecmaVersion": "latest",
    "sourceType": "module"
  },
  "rules": {
    "no-unused-vars": [
      "error",
      {
        "argsIgnorePattern": "^_"
      }
    ],
    "no-console": "warn",
    "import/no-unresolved": "error"
  },
  "overrides": [
    {
      "files": ["front-end/**/*.js", "**/Front-end/*.js", "vennela_frontend/*.js"],
      "parserOptions": {
        "sourceType": "script",
        "ecmaFeatures": {
          "globalReturn": false
        }
      },
      "rules": {
        "no-unused-vars": [
          "error",
          {
            "vars": "local",
            "argsIgnorePattern": "^_"
          }
        ]
      },
      "env": {
        "browser": true,
        "node": false
      }
    }
  ]
}
