POSTGRES_DB=trafficvision
POSTGRES_USER=traffic
POSTGRES_PASSWORD=change_me
POSTGRES_PORT=5432

REDIS_PORT=6379
BACKEND_PORT=8000

DATABASE_URL=postgresql+psycopg2://traffic:change_me@postgres:5432/trafficvision
REDIS_URL=redis://redis:6379/0

# Milestone 3 (optional overrides — defaults live in docker-compose.dev.yml)
# BACKEND_DIR=./backend_updated/backend/Intern_AI AND ML
ANALYTICS_DIR=./daa/M3_Day6_Traffic_Monitoring_
# ANALYTICS_PORT=8001

# Required (M3): app/security/config.py reads SECRET_KEY and ALGORITHM.
# Generate each with: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=change_me_to_a_long_random_value
ALGORITHM=HS256

# The backend uses DATABASE_URL when set; AUTH_DB_* are fallback settings otherwise.
# Keep these consistent with the Postgres service if DATABASE_URL is removed.
# AUTH_DB_HOST=postgres
# AUTH_DB_PORT=5432
# AUTH_DB_NAME=trafficvision
# AUTH_DB_USER=traffic
# AUTH_DB_PASSWORD=change_me

# JWT_SECRET_KEY is kept for components that still consume the legacy variable.
JWT_SECRET_KEY=change_me_to_a_long_random_value
ALERT_SERVICE_KEY=change_me_to_a_long_random_value
