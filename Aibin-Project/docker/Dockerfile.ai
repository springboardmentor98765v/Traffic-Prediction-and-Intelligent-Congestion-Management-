# ==============================================================================
# TrafficVision AI — AI/ML Inference Engine (Reference Dockerfile)
# Role: Intern 3 (saksham-aiml)
# Provided by: Intern 1 (Team Lead / Backend & Integration)
# ==============================================================================

FROM python:3.11-slim AS builder

WORKDIR /build

RUN apt-get update && apt-get install -y --no-install-recommends \
    build-essential \
    && rm -rf /var/lib/apt/lists/*

RUN pip install --no-cache-dir --user \
    fastapi>=0.110.0 \
    uvicorn>=0.28.0 \
    pydantic>=2.6.0 \
    requests>=2.31.0 \
    pandas>=2.2.0 \
    scikit-learn>=1.4.0 \
    joblib>=1.3.0

FROM python:3.11-slim AS runner

WORKDIR /app

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    APP_ENV=production \
    PATH=/home/appuser/.local/bin:$PATH

RUN groupadd -g 10001 appuser \
    && useradd -u 10001 -g appuser -s /bin/bash -m appuser

COPY --from=builder /root/.local /home/appuser/.local

# Copy ai_engine package and model artifact from saksham-aiml
COPY --chown=appuser:appuser ai_engine /app/ai_engine

USER appuser

EXPOSE 8001

HEALTHCHECK --interval=20s --timeout=5s --start-period=15s --retries=3 \
    CMD python -c "import urllib.request; urllib.request.urlopen('http://localhost:8001/predict/peak-hours?hour=12')" || exit 1

CMD ["uvicorn", "ai_engine.main:app", "--host", "0.0.0.0", "--port", "8001"]
