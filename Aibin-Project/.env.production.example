# ==============================================================================
# TrafficVision AI — Production Environment Variables Template (.env.production.example)
# Milestone 4 Production Deployment Contract
# ==============================================================================
# INSTRUCTIONS:
# 1. Copy this file to .env.production on your deployment server:
#    cp .env.production.example .env.production
# 2. Replace all placeholder values marked with <YOUR_...> with real credentials.
# 3. NEVER commit the populated .env.production file to version control.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. GLOBAL ENVIRONMENT & LOGGING
# ------------------------------------------------------------------------------
APP_ENV=production
LOG_LEVEL=info
HOST=0.0.0.0
PORT=8080

# ------------------------------------------------------------------------------
# 2. MANAGED DATABASE (PostgreSQL - Neon / Supabase / Aiven / RDS)
# ------------------------------------------------------------------------------
# Full connection URI for SQLAlchemy (Gateway Auth, Alert Service, Route Analysis)
DATABASE_URL=postgresql://<YOUR_DB_USER>:<YOUR_DB_PASSWORD>@<YOUR_DB_HOST>:5432/<YOUR_DB_NAME>?sslmode=require

# Discrete DB credentials for Intern 2 (anmol-data traffic_api.py compatibility)
DB_HOST=<YOUR_DB_HOST>
DB_PORT=5432
DB_NAME=<YOUR_DB_NAME>
DB_USER=<YOUR_DB_USER>
DB_PASSWORD=<YOUR_DB_PASSWORD>

# ------------------------------------------------------------------------------
# 3. CACHING & RATE LIMITING (Redis)
# ------------------------------------------------------------------------------
# In Docker Compose, redis runs as internal service: redis://redis:6379/0
# If using managed Upstash/Cloud Redis: rediss://default:<YOUR_TOKEN>@<YOUR_HOST>:6379
REDIS_URL=redis://redis:6379/0

# Discrete Redis credentials for Intern 2 (anmol-data traffic_api.py compatibility)
REDIS_HOST=redis
REDIS_PORT=6379

# ------------------------------------------------------------------------------
# 4. SECURITY & AUTHENTICATION (JWT & RBAC)
# ------------------------------------------------------------------------------
# Generate with: openssl rand -hex 32
JWT_SECRET_KEY=<YOUR_STRONG_RANDOM_SECRET_KEY_MIN_32_CHARS>
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7

# ------------------------------------------------------------------------------
# 5. API GATEWAY HARDENING & CORS
# ------------------------------------------------------------------------------
# Comma-separated list of allowed origins. Wildcard * is forbidden in production!
CORS_ALLOWED_ORIGINS=http://localhost:3000,https://<YOUR_FRONTEND_DOMAIN>.vercel.app

# Rate Limiting (Requests per minute per client IP)
RATE_LIMIT_GLOBAL_PER_MIN=120
RATE_LIMIT_AUTH_PER_MIN=10

# Reverse Proxy / TLS Settings
TRUST_PROXIES=true
FORCE_HTTPS=false

# ------------------------------------------------------------------------------
# 6. INTERNAL MICROSERVICE URLS (Docker Network DNS or Cloud Endpoints)
# ------------------------------------------------------------------------------
# In Docker Compose, use internal service names:
DATA_ENGINEERING_URL=http://traffic-monitoring:8000
TRAFFIC_SERVICE_URL=http://traffic-monitoring:8000
AI_ENGINE_URL=http://ai-engine:8001
PREDICTION_SERVICE_URL=http://ai-engine:8001
ROUTE_ANALYSIS_URL=http://route-analysis:8002
ALERT_SERVICE_URL=http://alert-service:8003

# ------------------------------------------------------------------------------
# 7. MAPS & ROUTING SERVICES
# ------------------------------------------------------------------------------
OSRM_BASE_URL=https://router.project-osrm.org
MAPS_API_KEY=<OPTIONAL_MAP_PROVIDER_API_KEY>

# ------------------------------------------------------------------------------
# 8. FRONTEND CLIENT REFERENCE (For Intern 4 Reference)
# ------------------------------------------------------------------------------
# Set this in hariom-frontend/.env.production or Vercel Environment Variables:
# NEXT_PUBLIC_API_URL=https://<YOUR_GATEWAY_DOMAIN_OR_IP>:8080/api/v1
